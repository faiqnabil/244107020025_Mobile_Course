        "# 1. Ekualisasi Biasa (Kanal Y)\n",
        "ycrcb = cv.cvtColor(bgr, cv.COLOR_BGR2YCrCb)\n",
        "y, cr, cb = cv.split(ycrcb)\n",
        "he_y = cv.cvtColor(cv.merge([cv.equalizeHist(y), cr, cb]), cv.COLOR_YCrCb2BGR)\n",
        "\n",
        "# 2. CLAHE (Kanal Y)\n",
        "clahe = cv.createCLAHE(clipLimit=PARAM['clip'], tileGridSize=(PARAM['tile'], PARAM['tile']))\n",
        "clahe_y_channel = clahe.apply(y)\n",
        "clahe_y = cv.cvtColor(cv.merge([clahe_y_channel, cr, cb]), cv.COLOR_YCrCb2BGR)\n",
