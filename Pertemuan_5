        "import cv2 as cv\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# -------------------------------------------------------------\n",
        "# 1. Buka Citra KTM1d.jpeg\n",
        "# -------------------------------------------------------------\n",
        "berkas = '/content/drive/MyDrive/PCVK_SMT5/KTM1d.jpeg'\n",
        "bgr = cv.imread(berkas)\n",
        "\n",
        "if bgr is None:\n",
        "    print(f\"Error: File tidak ditemukan di {berkas}\")\n",
        "else:\n",
        "    # -------------------------------------------------------------\n",
        "    # 2. Proses Seluruh Metode Ekualisasi\n",
        "    # -------------------------------------------------------------\n",
        "    # Cara 1: Ekualisasi B, G, R terpisah\n",
        "    kanal = list(cv.split(bgr))\n",
        "    for i in range(3):\n",
        "        kanal[i] = cv.equalizeHist(kanal[i])\n",
        "    he_rgb = cv.merge(kanal)\n",
        "\n",
        "    # Cara 2a: Kanal Y (YCrCb)\n",
        "    ycrcb = cv.cvtColor(bgr, cv.COLOR_BGR2YCrCb)\n",
        "    y, cr, cb = cv.split(ycrcb)\n",
        "    he_y = cv.cvtColor(cv.merge([cv.equalizeHist(y), cr, cb]), cv.COLOR_YCrCb2BGR)\n",
        "\n",
        "    # Cara 2b: Kanal V (HSV)\n",
        "    hsv = cv.cvtColor(bgr, cv.COLOR_BGR2HSV)\n",
        "    h, sat, v = cv.split(hsv)\n",
        "    he_v = cv.cvtColor(cv.merge([h, sat, cv.equalizeHist(v)]), cv.COLOR_HSV2BGR)\n",
        "\n",
        "    # Cara 2c: Kanal L (LAB)\n",
        "    lab = cv.cvtColor(bgr, cv.COLOR_BGR2LAB)\n",
        "    l, a, b = cv.split(lab)\n",
        "    he_l = cv.cvtColor(cv.merge([cv.equalizeHist(l), a, b]), cv.COLOR_LAB2BGR)\n",
