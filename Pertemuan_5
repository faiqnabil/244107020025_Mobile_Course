        "    ax3.set_title('Histogram Asli', fontsize=8)\n",
        "    ax3.set_xlabel('Intensitas Warna', fontsize=7)\n",
        "    ax3.set_ylabel('Jumlah Kemunculan', fontsize=7)\n",
