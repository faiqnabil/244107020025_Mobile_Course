        "import cv2 as cv\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# -------------------------------------------------------------\n",
        "# 0. Fungsi Dithering Floyd-Steinberg Grayscale\n",
        "# -------------------------------------------------------------\n",
        "def floyd_steinberg_dithering_gray(img_gray, levels=2):\n",
        "    img = img_gray.astype(np.float64)\n",
        "    h, w = img.shape\n",
        "    step = 255.0 / (levels - 1)\n",
        "\n",
        "    for y in range(h):\n",
        "        for x in range(w):\n",
        "            old_val = img[y, x]\n",
        "            new_val = np.round(old_val / step) * step\n",
        "            img[y, x] = new_val\n",
        "            error = old_val - new_val\n",
        "\n",
        "            # Distribusi Error ke 4 Tetangga\n",
        "            if x + 1 < w:\n",
        "                img[y, x + 1] += error * (7 / 16)\n",
        "            if y + 1 < h:\n",
        "                if x - 1 >= 0:\n",
        "                    img[y + 1, x - 1] += error * (3 / 16)\n",
        "                img[y + 1, x] += error * (5 / 16)\n",
        "                if x + 1 < w:\n",
        "                    img[y + 1, x + 1] += error * (1 / 16)\n",
        "\n",
        "    return np.clip(img, 0, 255).astype(np.uint8)\n",
        "\n",
        "# -------------------------------------------------------------\n",
        "# 3. Pengulangan pada KTM1a.jpeg\n",
        "# -------------------------------------------------------------\n",
        "path_ktm = '/content/drive/MyDrive/PCVK_SMT5/KTM1a.jpeg'\n",
