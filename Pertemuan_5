        "\n",
        "# 1. Definisi Fungsi Ekualisasi Manual & OpenCV\n",
        "def histogram_equalization_manual(img_rgb):\n",
        "    height, width, channels = img_rgb.shape\n",
        "    total_pixels = height * width\n",
        "    img_equalized = np.zeros_like(img_rgb)\n",
        "\n",
        "    for c in range(channels):\n",
        "        channel_data = img_rgb[:, :, c]\n",
        "        freq, _ = np.histogram(channel_data.flatten(), bins=256, range=[0, 256])\n",
        "        cdf = np.cumsum(freq) / total_pixels\n",
        "        transform_map = np.round(cdf * 255).astype(np.uint8)\n",
        "        img_equalized[:, :, c] = transform_map[channel_data]\n",
        "\n",
        "    return img_equalized\n",
        "\n",
        "def histogram_equalization_cv2(img_bgr):\n",
        "    # Potongan kode cv2.split & cv2.equalizeHist\n",
        "    b, g, r = cv2.split(img_bgr)\n",
        "\n",
        "    b_equalized = cv2.equalizeHist(b)\n",
        "    g_equalized = cv2.equalizeHist(g)\n",
        "    r_equalized = cv2.equalizeHist(r)\n",
        "\n",
        "    img_eq_bgr = cv2.merge((b_equalized, g_equalized, r_equalized))\n",
        "    return cv2.cvtColor(img_eq_bgr, cv2.COLOR_BGR2RGB)\n",
        "\n",
        "# 2. Buka dan Proses Gambar lena_lc.jpg\n",
        "path_lena = '/content/drive/MyDrive/PCVK_SMT5/lena_lc.jpg'\n",
