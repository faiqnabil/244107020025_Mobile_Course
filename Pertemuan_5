        "# 1. Fungsi Dithering Floyd-Steinberg Vektor (RGB/Multi-Channel)\n",
        "# -------------------------------------------------------------\n",
        "def floyd_steinberg_dithering_color(img_bgr, levels=2):\n",
        "    # Konversi ke float64 untuk presisi akumulasi error\n",
        "    img = img_bgr.astype(np.float64)\n",
