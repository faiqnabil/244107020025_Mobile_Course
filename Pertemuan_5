        "else:\n",
        "    # A. Ekualisasi Histogram\n",
        "    ktm_he = cv.equalizeHist(ktm_gray)\n",
        "\n",
        "    # B. Dithering Floyd-Steinberg dari hasil ekualisasi\n",
        "    ktm_dither_he = floyd_steinberg_dithering_gray(ktm_he, levels=2)\n",
        "\n",
        "    # C. Grid Layout 3 Baris Compact (7x6 inci)\n",
        "    fig = plt.figure(figsize=(7, 6))\n",
