        "import cv2 as cv\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# -------------------------------------------------------------\n",
        "# 1. Fungsi Dithering Floyd-Steinberg (Multi-Channel / RGB)\n",
        "# -------------------------------------------------------------\n",
        "def floyd_steinberg_dithering_color(img_bgr, levels=2):\n",
        "    img = img_bgr.astype(np.float64)\n",
        "    h, w, c = img.shape\n",
        "    step = 255.0 / (levels - 1)\n",
        "\n",
        "    for y in range(h):\n",
        "        for x in range(w):\n",
        "            for ch in range(c):\n",
        "                old_val = img[y, x, ch]\n",
        "                new_val = np.round(old_val / step) * step\n",
        "                img[y, x, ch] = new_val\n",
        "                error = old_val - new_val\n",
        "\n",
        "                # Distribusi Error ke 4 Tetangga\n",
        "                if x + 1 < w:\n",
        "                    img[y, x + 1, ch] += error * (7 / 16)\n",
        "                if y + 1 < h:\n",
        "                    if x - 1 >= 0:\n",
        "                        img[y + 1, x - 1, ch] += error * (3 / 16)\n",
        "                    img[y + 1, x, ch] += error * (5 / 16)\n",
        "                    if x + 1 < w:\n",
        "                        img[y + 1, x + 1, ch] += error * (1 / 16)\n",
        "\n",
        "    return np.clip(img, 0, 255).astype(np.uint8)\n",
